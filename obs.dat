# Number of regions
Regions: 5

# Assuming that both XRISM and NuSTAR data for the cluster are in the same 
# parent directory (if they are not please make it so) 
main_directory = "/Users/christiannorseth/GradResearch"

# the name of the output script, located in the parent directory
output_script = "Virgo/nustarAndXrism.xcm"

----------------------------------------------------------------------------
###### NuSTAR ######
----------------------------------------------------------------------------
nu_directory = "Virgo/arf"
nu_reg_base = "arf"

nu_obsids = [
    50502002002 
    50502002004 
    50502002006 
    60502010002 
    60502010004 
    60702051001 
    60702051002 
    60801007002 
    90202052002 
    90202052004
]


----------------------------------------------------------------------------
###### XRISM ######
----------------------------------------------------------------------------
